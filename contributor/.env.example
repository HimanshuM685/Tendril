# REQUIRED. Contributor API key minted in the web app (Contribute → mint).
# The wallet that minted it owns this node and receives earnings.
TENDRIL_API_KEY=

NODE_LABEL=my-laptop
PRICE_PER_HOUR_USD=1.0

# Image renters run. Built locally on first start when it is the bundled one.
# A custom image is never built or pulled; for SSH leases it must also provide the
# bundled image's /entrypoint.sh `sandbox` role and a uid-1000 `tendril` user.
SANDBOX_IMAGE=tendril-ssh-sandbox:latest
# Extra images this machine agrees to run if the registry asks (comma-separated).
# Anything else the registry names is refused.
SANDBOX_ALLOWED_IMAGES=
# Ceilings for one sandbox. The registry can ask for less, never more.
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# Writable scratch per sandbox. RAM-backed: it shares SANDBOX_MEMORY with the
# renter's processes and is capped at that limit.
SANDBOX_DISK=1g
# "all" to rent out GPUs. Opt-in: passthrough widens the sandbox's attack surface.
SANDBOX_GPUS=
# Per-sandbox firewall: blocks this host, its LAN, and cloud metadata from inside
# the sandbox. Leave on. "off" only on an isolated VPS with nothing else on it.
SANDBOX_NET_GUARD=on
# Extra addresses of this host to fence off (comma-separated).
# The agent already blocks its own interface addresses; add a NAT'd public IP, or the
# host's IPs when the agent itself runs inside Docker.
SANDBOX_BLOCK_ADDRS=

# bore = sandbox dials out. local = SSH on 127.0.0.1 only.
TUNNEL_MODE=bore
HEARTBEAT_INTERVAL_MS=10000

# Self-host only. Unset uses the hosted registry.
# REGISTRY_URL=http://localhost:4000
