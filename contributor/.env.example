# REQUIRED. Contributor API key minted in the web app (Contribute → mint).
# The wallet that minted it owns this node and receives earnings.
TENDRIL_API_KEY=

NODE_LABEL=my-laptop
PRICE_PER_HOUR_USD=1.0

SANDBOX_IMAGE=tendril-ssh-sandbox:latest
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_GPUS=

# bore = sandbox dials out. local = SSH on 127.0.0.1 only.
TUNNEL_MODE=bore
HEARTBEAT_INTERVAL_MS=10000

# Self-host only. Unset uses the hosted registry.
# REGISTRY_URL=http://localhost:4000
