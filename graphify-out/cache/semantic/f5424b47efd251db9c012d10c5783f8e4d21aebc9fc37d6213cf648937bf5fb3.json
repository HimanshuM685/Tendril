_file": "README.md", "source_location": "lines 23-24, 134-136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_x402_facilitator", "label": "x402 Facilitator", "file_type": "concept", "source_file": "README.md", "source_location": "lines 43-47, 58-64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_neon_postgres", "label": "Neon Postgres", "file_type": "concept", "source_file": "README.md", "source_location": "lines 45-47, 130-131", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_watchdog", "label": "Lease Watchdog", "file_type": "concept", "source_file": "README.md", "source_location": "lines 52, 329-336", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_payment_is_identity", "label": "Payment as Identity", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 13-15, 63-64, 346-349", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payment is the identity: a brand-new address can pay on its very first request with no sign-up or sign-in. Credit is keyed to the sender of the settled transaction, never to anything the client claims about itself."}, {"id": "readme_verify_settle_ordering", "label": "Verify-Then-Settle Ordering", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 58-64, 337-338", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settlement ordering is verify, do the work, then settle: the facilitator verifies the payment group by simulation, the backend provisions, and only then is payment settled on-chain, so a sandbox that fails to start (503) costs the caller nothing."}, {"id": "readme_custodial_model", "label": "Custodial Model", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 322-328", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payments pool at one platform address and credit is an off-chain ledger in Neon with one schema per network; every payment is recorded by txid so replaying one cannot credit twice."}, {"id": "readme_two_ledger_isolation", "label": "Per-Network Ledger Isolation", "file_type": "rationale", "source_file": "README.md", "source_location": "lines 243-251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two ledgers never mix: one database, one Postgres schema per network (testnet.* / mainnet.*), search_path resolves every query to that network's tables, so testnet play money can never be read as a mainnet balance."}, {"id": "readme_bazaar_discovery", "label": "Bazaar Discovery (GoPlausible)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 258-292", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_backend_registry", "label": "Backend / Registry", "file_type": "concept", "source_file": "README.md", "source_location": "lines 36-52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_contributor_agent", "label": "Contributor Agent", "file_type": "concept", "source_file": "README.md", "source_location": "lines 38-40, 53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_web_spa", "label": "Web App (Vite React SPA)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 54, 210-218, 350-351", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_example_buyer", "label": "Example Buyer (Headless Agent)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 55, 173-174", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_types", "label": "@tendril/shared", "f