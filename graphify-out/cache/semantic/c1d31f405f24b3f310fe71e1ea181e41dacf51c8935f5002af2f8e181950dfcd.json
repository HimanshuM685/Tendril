{"nodes": [{"id": "runtime_runtime_linux_microvm_runtime", "label": "Linux microVM runtime", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "1-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firecracker isolates contributor leases; guest filesystems never shared with host."}, {"id": "runtime_runtime_contributor_lease", "label": "Contributor lease", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "3-8,123-136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_runtime_firecracker", "label": "Firecracker and jailer v1.12.1", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "3,45-60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_runtime_oci_template", "label": "Cached immutable ext4 guest template", "file_type": "rationale", "source_file": "docs/runtime.md", "source_location": "3-8,79-89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export OCI image once before listing; copy cached template per paid lease and inject credentials offline. Unprepared custom images fail instead of exporting during paid lease."}, {"id": "runtime_runtime_runtime_selection", "label": "TENDRIL_RUNTIME selection", "file_type": "rationale", "source_file": "docs/runtime.md", "source_location": "10-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto may fall back to legacy Docker after preflight/cache failure; explicit Firecracker fails startup on missing prerequisites and never retries Docker or Modal after provisioning failure."}, {"id": "runtime_runtime_capabilities", "label": "Heartbeat runtime and capabilities", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "20-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capability determines eligibility; idle connected microVMs receive placement priority; missing map fields are false, while absent maps retain legacy SSH/Python support."}, {"id": "runtime_runtime_native_prerequisites", "label": "Native contributor prerequisites", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "26-37,45-77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "runtime_runtime_guest_network", "label": "Per-guest namespace and TAP networking", "file_type": "rationale", "source_file": "docs/runtime.md", "source_location": "39-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Namespace-local and lease-owned host NAT permit outbound downloads; TAPs are not LAN bridges, agent opens no inbound TCP, teardown removes forwarding rules."}, {"id": "runtime_runtime_resource_bounds", "label": "Jailer ownership and resource bounds", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "74-84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate agent/VMM cgroups satisfy cgroup v2 no-internal-process rule; quotas, memory overhead, PID/FD caps, guest ulimits and disk size bound resource use."}, {"id": "runtime_runtime_relay_manager", "label": "Platform bore relay manager", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "91-96,109-114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate unprivileged native service controlled by backend over Unix IPC; no public HTTP administration endpoint."}, {"id": "runtime_runtime_tls_relay", "label": "Wildcard DNS and TLS relay", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "98-107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Control and notebook traffic use trusted TLS; private raw notebook listener ports remain accessible only to backend on relay host."}, {"id": "runtime_runtime_guest_access", "label": "Guest SSH, Jupyter and notebook execution", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "116-121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notebook uploads/results use guest Jupyter Contents API; jobs run via papermill over private TAP; Jupyter token remains ephemeral and is never logged or stored in Neon."}, {"id": "runtime_runtime_release_protocol", "label": "Lease Release and cleanup protocol", "file_type": "rationale", "source_file": "docs/runtime.md", "source_location": "123-136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First close freezes billing cutoff; peer remains reserved until guest and relay destruction acknowledged. Retried cleanup keeps original cutoff, charge and earnings use lease-ID idempotency keys."}, {"id": "runtime_runtime_readiness_gate", "label": "SSH and Jupyter readiness gate", "file_type": "rationale", "source_file": "docs/runtime.md", "source_location": "132-134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Require authenticated guest readiness before activation/settlement; destroy late readiness and avoid charging abandoned or unstarted attempts."}, {"id": "runtime_runtime_default_ci", "label": "Default P1 CI verification", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "138-148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CI verifies contracts without KVM, database, funded wallet or privileged networking."}, {"id": "runtime_runtime_real_kernel_gate", "label": "Opt-in real-kernel KVM gate", "file_type": "concept", "source_file": "docs/runtime.md", "source_location": "150-166", "source_url": null, "captured_at": null, "author": null, "contributor": nu