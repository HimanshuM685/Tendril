# ─────────────────────────── Tendril environment ───────────────────────────
# Copy to .env and fill in. The backend, contributor, and buyer all read this
# one file. Defaults target Algorand TESTNET.
#
# A machine usually runs ONE role: the backend, OR a contributor, OR the buyer.
# Fill in the section for the role this machine runs; leave the rest as defaults.


# ── Backend registry address (contributor + buyer point here) ───────────────
# The URL of the backend/registry to connect to.
#   • backend on this same machine  → http://localhost:4000
#   • backend on a server/VPS        → http://YOUR_SERVER_IP:4000  (or https://api.your-domain.com)
REGISTRY_URL=http://localhost:4000

# ── Algorand: testnet / mainnet switch ──────────────────────────────────────
# THE network switch. Everything chain-specific — the CAIP-2 id every payment
# must be on, the algod endpoint, the USDC asset id, the block explorer — is
# derived from this one value, so the pieces can't be left half-migrated.
#
#   testnet → USDC 10458941, https://testnet-api.algonode.cloud
#   mainnet → USDC 31566704, https://mainnet-api.algonode.cloud
#
# An unrecognised value crashes at boot on purpose: silently running testnet
# while you believe you configured mainnet is worse than not starting.
ALGORAND_NETWORK=testnet

# Browser apps are separate Next.js workspaces. Do not put their public values
# in this root file. Copy each app example to its own `.env.local` instead:
#
#   cp web/.env.example web/.env.local
#   cp docs-web/.env.example docs-web/.env.local
#   cp admin/.env.example admin/.env.local
#
# Next.js embeds NEXT_PUBLIC_* values during build. Keep the network aligned with
# ALGORAND_NETWORK above.

# Before switching to mainnet, check that: PLATFORM_PAYTO has opted into mainnet
# USDC and holds ALGO for payout fees; the facilitator below supports mainnet
# (its /supported must advertise the mainnet CAIP-2 id, or every payment fails
# to verify); and node prices are what you want to charge in real dollars.

# Optional per-value overrides — leave unset to follow ALGORAND_NETWORK.
# Point ALGOD_URL at a private node if you don't want to depend on algonode.
# ALGOD_URL=https://testnet-api.algonode.cloud
# X402_ASSET_ID / X402_ASSET_SYMBOL only need setting to bill in a non-USDC ASA.
# Base64-encoded 64-byte Algorand key (seed||pubkey) for the BUYER agent — the
# headless client that pays for compute. Generate one with `npm run keygen`, then
# OPT THE ADDRESS INTO the payment asset below and fund it from
# https://asset-dispenser.testnet.algorand.network. Keep it secret.
# Buyers need no ALGO at all: the facilitator sponsors the network fee.
# Contributors do NOT set this — they authenticate with an API key (see below).
AVM_PRIVATE_KEY=


# ════════════════════════ Role: BACKEND / REGISTRY ══════════════════════════
# (only needed on the machine running `npm run backend`)
REGISTRY_PORT=4000
# Neon (Postgres) connection string — stores ONLY the credit ledger, payments,
# charges and payouts (nodes + leases are kept in memory). Create a free project at
# https://neon.tech and copy its connection string (keep ?sslmode=require). REQUIRED.
#
# ONE database, one schema per network: ALGORAND_NETWORK=testnet puts every table
# in the `testnet` schema, mainnet in `mainnet`. The connection's search_path
# points at the right one, so testnet play money can never be read as a mainnet
# balance and switching networks starts from an empty ledger rather than
# inheriting the other's rows. Both schemas are created automatically at boot.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Algorand address that receives every x402 payment. All prepaid credit is held
# here; usage is debited from the off-chain ledger. REQUIRED.
# Generate a key with `npm run keygen`, use its Address, and OPT IT IN to the
# payment asset — payments to an address that has not opted in simply fail.
PLATFORM_PAYTO=
# Base64 64-byte secret key for PLATFORM_PAYTO — signs contributor withdrawals.
# REQUIRED for withdrawals. This is the key `npm run keygen` prints for the
# PLATFORM_PAYTO account. Safeguard it: it custodies all user top-ups.
PLATFORM_PRIVATE_KEY=
# Platform's % cut of each charge; the remainder is credited to the contributor.
PLATFORM_FEE_PCT=1
# Least a contributor may withdraw at once. A closed lease credits an earnings
# balance rather than sending on-chain, so this floor keeps one transfer from
# costing more in fees and attention than it moves. 5000000 = 5.00 USDC.
MIN_WITHDRAW_ATOMIC=5000000
# Secret used to sign wallet-session + lease tokens. Use any random string for
# local dev; set a strong secret in production.
JWT_SECRET=dev-secret-change-me
# ── Google OAuth custodial login (optional) ─────────────────────────────────
# When all four are set, the web app shows "Continue with Google". Each Google
# account gets a server-custodied Algorand wallet (mnemonic encrypted at rest).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# WEB_ORIGIN=http://localhost:5173
# 32-byte secret for AES-256-GCM mnemonic encryption — openssl rand -base64 32
# WALLET_ENCRYPTION_KEY=
# ── Email + password login (optional, toggled in admin Settings) ────────────
# Used only when no admin toggle has been saved yet. After that, admin panel wins.
# EMAIL_AUTH_DEFAULT=true
# ── Admin portal (optional) ─────────────────────────────────────────────────
# Separate Next.js admin app at admin.tendrilhq.com — Google OAuth with email allowlist.
# Register a SECOND redirect URI in Google Cloud Console for the admin callback.
# ADMIN_EMAILS=you@tendrilhq.com,other@tendrilhq.com
# ADMIN_WEB_ORIGIN=http://localhost:5174
# ADMIN_GOOGLE_REDIRECT_URI=http://localhost:4000/admin/auth/google/callback
# ALGO sent to Google custodial users on admin accept (default 0.26 ALGO).
# GAS_GRANT_MICRO_ALGOS=260000
# How long (ms) a node may go without a heartbeat before it's marked offline.
HEARTBEAT_TIMEOUT_MS=30000
# How often (ms) the watchdog checks active leases for expiry. It does not bill
# per tick — open-ended leases are charged once when they close.
METER_INTERVAL_MS=10000
# Runtime given to a renter whose credit has run out, so they can save their work
# before the sandbox is destroyed. Atomic units, converted to seconds at that
# lease's own rate — so it's the same dollar of goodwill on a cheap node as on an
# expensive one. The platform absorbs it. Set to 0 to cut sessions off outright.
GRACE_ATOMIC=1000000

# ── Hosted CPU (Modal sandboxes) ────────────────────────────────────────────
# Used only by the backend. Enables priority notebook jobs on hosted CPU. These
# tokens must never be set on the web app or a contributor. Create them at
# https://modal.com/settings/tokens — MODAL_TOKEN_ID and MODAL_TOKEN_SECRET.
# Hosted USD/hr is Modal's sandbox rate plus HOSTED_MARKUP (clamped to 25–40%).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_APP_NAME=tendril
# HOSTED_MARKUP=0.30
# First notebook image build can take minutes. Notebook gate fee settles before
# provisioning; a startup failure uses no execution credit but retains that fee.
# MODAL_SANDBOX_READY_TIMEOUT_MS=300000

# ── Hosted CPU (E2B sandboxes) ──────────────────────────────────────────────
# Used only by the backend. Enables the "e2b" notebook lane. Create a key at
# https://e2b.dev/dashboard. Billed at E2B's vCPU + RAM rate (2 vCPU, 4 GiB) plus
# E2B_MARKUP (clamped to 20–30%).
# E2B_API_KEY=
# E2B_MARKUP=0.25
# Empty = E2B's default code-interpreter template (jupyter, ipykernel, pandas…).
# E2B_TEMPLATE=
# E2B_SANDBOX_READY_TIMEOUT_MS=60000
# Each size (1–8 vCPU × 1–8 GiB) is its own prebuilt template, tendril-nb-c{vCPU}-m{GiB},
# built once per E2B account. The presets warm at boot; a custom size builds on first use.
# E2B_TEMPLATE_BUILD_TIMEOUT_MS=900000

# Native backend and platform relay share a protected Unix socket. Contributor
# SSH, Jupyter and notebook transport go through it (see DEPLOY.md "Relay").
# RELAY_SOCKET=/run/tendril-relay/control.sock
# SANDBOX_STOP_TIMEOUT_MS=30000

# Hard ceiling on one POST /x402/run job (ms), at most 900000 (15 minutes).
# Script jobs may overdraw credit; notebooks also stop at their prepaid budget.
RUN_TIMEOUT_MS=120000

# ── x402 (the only way money enters the platform) ───────────────────────────
# NOTE: X402_NETWORK, X402_ASSET_ID, X402_ASSET_DECIMALS and X402_ASSET_SYMBOL
# all follow ALGORAND_NETWORK above and are left unset on purpose. Set one only
# to override it — e.g. to bill in an ASA other than USDC. If you do set
# X402_NETWORK, it must match what the facilitator's /supported advertises byte
# for byte (full genesis hash, not the 32-char truncated form).
#
# X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# X402_ASSET_ID=10458941
# X402_ASSET_DECIMALS=6
# X402_ASSET_SYMBOL=USDC
#
# There is no exchange rate anywhere: USDC is a dollar and has 6 decimals, so
# PRICE_PER_HOUR_USD * 1e6 is the atomic amount.
# Verifies (simulates) and settles payment groups, and signs the fee-payer
# transaction — which is why a client needs USDC but no ALGO.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# How long a 402 challenge stays payable.
X402_MAX_TIMEOUT_SECONDS=60

# ── Bazaar discovery (being findable, as opposed to being paid) ─────────────
# Settlement and discovery are separate systems. Payments can settle perfectly
# while the endpoint stays invisible in the Bazaar and on the leaderboard.
#
# Discovery is triggered by a SETTLED PAYMENT. An endpoint that always resolves
# from a caller's existing credit never settles on-chain, so it is never
# cataloged — pay it once from an address with no credit to register it.
#
# Verify (needs one successful payment first):
#   curl -s "https://facilitator.goplausible.xyz/discovery/resources?includeTestnets=true&limit=1000" \
#     | jq '.items[] | select(.resourceUrl | contains("your-domain"))'
#
# The tag the facilitator attributes activity by. Required for the endpoint to
# be recognised as part of the x402 Global Challenge.
X402_TAG=x402-global-challenge
# Extra categorisation tags, comma-separated. 5 tags TOTAL (including the one
# above), 32 printable-ASCII chars each — anything past the cap is dropped.
X402_EXTRA_TAGS=compute,ssh,sandbox
# How the API is named in the dashboard. Keep it to the name alone — a tagline
# here shows up AS the service name. Max 32 printable-ASCII chars. Should match
# the web app's <title> and og:site_name, since the facilitator may take either.
X402_SERVICE_NAME=TENDRIL
# Publicly reachable http(s) logo. Anything else (a data: URI, a private host)
# is rejected by the facilitator and the listing just has no icon.
X402_ICON_URL=
# The PUBLIC base URL this registry answers on. Discovery canonicalises the
# catalog entry on this origin, so behind a proxy or tunnel it MUST be set —
# otherwise you are cataloged as http://localhost:4000, which nobody can reach.
# Custodial Google sign-in pays x402 via loopback (127.0.0.1:REGISTRY_PORT);
# this URL is for client-facing discovery only.
PUBLIC_BASE_URL=
# Optional override when the backend cannot reach itself at 127.0.0.1 (rare).
# INTERNAL_REGISTRY_HOST=127.0.0.1

# ── Flat-price routes ("pay this much to execute") ──────────────────────────
# The simple way to buy: one fixed price per call, no quote, no credit maths.
#   POST /rent/:nodeId    -> FLAT_RENT_ATOMIC opens a metered session
#   POST /lease/:id/run   -> FLAT_RUN_ATOMIC  buys one job execution
# Renting buys no fixed block: the gate fee starts the meter, the session runs
# for as long as the renter's credit covers PRICE_PER_HOUR_USD, and the seconds
# actually used are billed from credit when it closes.
FLAT_RENT_ATOMIC=10000
FLAT_RUN_ATOMIC=10000
# On-chain fee to mint a contributor API key (POST /x402/keys). 100000 = 0.10 USDC.
FLAT_MINT_KEY_ATOMIC=100000

# Top-up is NOT flat: POST /topup?amount=<atomic> credits whatever the caller
# asks for, anywhere between MIN_TOPUP_ATOMIC and MAX_TOPUP_ATOMIC — 4 USDC,
# 400, 609, whatever. This is only the fallback when ?amount= is omitted.
DEFAULT_TOPUP_ATOMIC=1000000

# ── Amount + lease bounds (atomic units of the asset above) ─────────────────
MIN_TOPUP_ATOMIC=100000
MAX_TOPUP_ATOMIC=1000000000
# Least credit a renter must hold to open a session, expressed as seconds of
# runtime at the node's rate. Below this the gate fee would buy a session the
# watchdog kills almost immediately.
MIN_LEASE_SECONDS=60
# How long to wait for a sandbox to come up before returning 503. Nothing is
# settled if this elapses — the caller pays nothing for a failed provision.
SANDBOX_READY_TIMEOUT_MS=45000
# Allowed web origins for CORS (comma-separated), or "*" for all. In production
# set this to your web app's origin, e.g. https://tendril.your-domain.com
# Include the admin SPA origin when deployed, e.g.:
# CORS_ORIGIN=https://tendril.your-domain.com,https://admin.tendrilhq.com
# NOTE: this does NOT cover the payable routes (/topup, /rent/:id,
# /lease/:id/run, /lease/:id/release, /x402/*). Those answer EVERY origin on
# purpose, so any browser can pay them — the 402 is what protects them and the
# price is the same whoever asks. Everything else (sign-in, /wallet, /metrics,
# /explorer, /nodes) stays behind this allowlist.
# CORS constrains browsers only; a headless agent was never subject to it.
CORS_ORIGIN=*

# ── Legacy tunnel compatibility (older contributor agents) ─────────────────
# New agents use per-lease verified TLS/bore allocations from RELAY_SOCKET.
# These hello-ack fields remain for older agents; neither configures the P1 relay.
BORE_SERVER=bore.pub
# Shared secret for a self-hosted bore server (run `bore server --secret <s>`).
# Leave empty for the public bore.pub.
BORE_SECRET=


# ═══════════════════════════ Role: CONTRIBUTOR ══════════════════════════════
# (only needed on a machine running `npm run contributor`)
# REQUIRED. Mint one in the web app: connect + sign in with your wallet, open
# CONTRIBUTE, click MINT API KEY. It is shown once.
# The key is the whole contributor identity: the wallet that minted it owns the
# node and is where earnings land — so there is no private key and no payout
# address here, and the tunnel settings come from the backend.
TENDRIL_API_KEY=
# Human label + advertised price per HOUR (USD) for this node.
NODE_LABEL=my-laptop
PRICE_PER_HOUR_USD=1.0
# OCI guest userspace: SSH/Python/notebook/Jupyter for microVMs, SSH/Python for Docker.
# MicroVM startup builds image/rootfs cache before registration; Docker builds on first use.
SANDBOX_IMAGE=tendril-ssh-sandbox:latest
# Resource caps applied to the sandbox runtime.
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# Legacy Docker only: "all" requires nvidia-container-toolkit. P1 microVMs have no GPU passthrough.
SANDBOX_GPUS=
# Legacy low-level tunnel mode. Backend-allocated per-lease TLS relay takes priority.
#   bore  → outbound TLS/bore (default)
#   local → loopback publication only for standalone Docker use without a relay allocation
TUNNEL_MODE=bore
# MicroVM isolation. Used only when /dev/kvm exists. GUEST_KERNEL is a guest
# vmlinux, not the host kernel. Without these, the agent stays on Docker and
# is hidden from Explore's default MicroVM filter.
# GUEST_KERNEL=/var/lib/tendril/vmlinux
# JAILER_BIN=jailer
# FIRECRACKER_BIN=firecracker
# TENDRIL_STATE_DIR=/var/lib/tendril
# auto preflights/cache-builds before registration; firecracker fails startup
# rather than advertising Docker. Paid microVM leases never fall through.
TENDRIL_RUNTIME=auto
# Dedicated unprivileged VMM account (id -u/-g tendril-vmm), not guest root UID.
# JAILER_UID=123
# JAILER_GID=123
# TENDRIL_CGROUP_PARENT=tendril
# GUEST_DISK_BYTES=4294967296
# VMM_OVERHEAD_MIB=128
# GUEST_DNS=1.1.1.1
# Full native Linux setup and TLS relay: docs/runtime.md
# Per-lease relay credentials/hostnames come from the backend, not contributor config.


# ═══════════════════════════════ Role: BUYER ════════════════════════════════
# (only needed on a machine running `npm run client`)
# Minimum RAM (MB) the agent requires when picking a node.
AGENT_MIN_RAM_MB=1024
# Length of the prepaid block the agent buys (seconds; must satisfy the
# MIN/MAX/GRANULARITY bounds above). Unused time comes back as credit.
AGENT_LEASE_SECONDS=300
# Atomic units of the payment asset the agent tops up (500000 = 0.50 USDC).
AGENT_TOPUP_ATOMIC=500000
