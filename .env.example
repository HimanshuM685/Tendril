# ─────────────────────────── Tendril environment ───────────────────────────
# Copy to .env and fill in. The backend, contributor, and buyer all read this
# one file. Defaults target Algorand TESTNET.
#
# A machine usually runs ONE role: the backend, OR a contributor, OR the buyer.
# Fill in the section for the role this machine runs; leave the rest as defaults.


# ── Backend registry address (contributor + buyer point here) ───────────────
# The URL of the backend/registry to connect to.
#   • backend on this same machine  → http://localhost:4000
#   • backend on a server/VPS        → http://YOUR_SERVER_IP:4000  (or https://api.your-domain.com)
REGISTRY_URL=http://localhost:4000

# ── Algorand ────────────────────────────────────────────────────────────────
# Algod endpoint used to submit + confirm ALGO payments.
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
# Base64-encoded 64-byte Algorand key (seed||pubkey) for the agent this machine
# runs — the contributor (earns ALGO) or the buyer (pays ALGO). Generate one
# with `npm run keygen`, then fund it with testnet ALGO. Keep it secret.
AVM_PRIVATE_KEY=


# ════════════════════════ Role: BACKEND / REGISTRY ══════════════════════════
# (only needed on the machine running `npm run backend`)
REGISTRY_PORT=4000
# Neon (Postgres) connection string — stores ONLY wallets, top-ups, charges and
# payouts (nodes + leases are kept in memory). Create a free project at
# https://neon.tech and copy its connection string (keep ?sslmode=require). REQUIRED.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Custodial Algorand address that receives user top-ups. All prepaid balances
# are held here; metered usage is debited from the off-chain ledger. REQUIRED.
# Generate a key with `npm run keygen` and use its Address (fund a little ALGO).
PLATFORM_PAYTO=
# Base64 64-byte secret key for PLATFORM_PAYTO — signs on-chain payouts to
# contributors when a lease ends. REQUIRED for payouts. This is the
# AVM_PRIVATE_KEY `npm run keygen` prints for the PLATFORM_PAYTO account.
# Safeguard it: it custodies all user top-ups.
PLATFORM_PRIVATE_KEY=
# Platform's % cut of each charge; the remainder is paid to the contributor.
PLATFORM_FEE_PCT=10
# Secret used to sign wallet-session + lease tokens. Use any random string for
# local dev; set a strong secret in production.
JWT_SECRET=dev-secret-change-me
# How long (ms) a node may go without a heartbeat before it's marked offline.
HEARTBEAT_TIMEOUT_MS=30000
# USD per 1 ALGO — converts a node's USD price into the microALGO/hour billing rate.
# Use a fixed rate for demos, or wire this to a price feed in production.
ALGO_USD_PRICE=0.20
# How often (ms) the watchdog checks active leases for balance exhaustion. It no
# longer bills per tick — usage is deducted ONCE, at lease end.
METER_INTERVAL_MS=10000
# Allowed web origins for CORS (comma-separated), or "*" for all. In production
# set this to your web app's origin, e.g. https://tendril.your-domain.com
CORS_ORIGIN=*


# ═══════════════════════════ Role: CONTRIBUTOR ══════════════════════════════
# (only needed on a machine running `npm run contributor`)
# Human label + advertised price per HOUR (USD) for this node.
NODE_LABEL=my-laptop
PRICE_PER_HOUR_USD=1.0
# SSH sandbox image. Renters get a plain SSH shell (not Jupyter). Left as the
# default, it's built locally on first run from contributor/sandbox-ssh.
SANDBOX_IMAGE=tendril-ssh-sandbox:latest
# Resource caps applied to the sandbox container.
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
# Set to "all" to pass GPUs through (requires nvidia-container-toolkit), else empty.
SANDBOX_GPUS=
# How the sandbox's SSH port is exposed publicly:
#   bore  → the container dials out to a bore server (default; works anywhere)
#   local → publish SSH to 127.0.0.1 (only when renter + contributor share a box)
TUNNEL_MODE=bore
# bore server the sandbox dials out to (only used when TUNNEL_MODE=bore).
# The public bore.pub is rate-limited/flaky — self-host `bore server` (e.g. on your
# backend host) and point this at it, e.g. BORE_SERVER=reg.007575.xyz
BORE_SERVER=bore.pub
# Shared secret for a self-hosted bore server (run `bore server --secret <s>`).
# Leave empty for the public bore.pub.
BORE_SECRET=


# ═══════════════════════════════ Role: BUYER ════════════════════════════════
# (only needed on a machine running `npm run client`)
# Minimum RAM (MB) the agent requires when picking a node.
AGENT_MIN_RAM_MB=1024
# Roughly how long the agent expects to compute (used to estimate usage).
AGENT_LEASE_MINUTES=1
# ALGO the agent deposits into its prepaid balance when it's running low.
AGENT_TOPUP_ALGO=0.5
