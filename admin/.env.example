# Admin app (Next.js). Copy to admin/.env.local — vars are inlined at build time.

# No trailing slash — `https://api.example.com/` becomes `//explorer` 404s.
NEXT_PUBLIC_REGISTRY_URL=http://localhost:4000
# NEXT_PUBLIC_EXPLORER_URL=https://lora.algokit.io/testnet

# NEXT_PUBLIC_* values are browser-visible and embedded at build time.
# Keep private keys, OAuth secrets, and ADMIN_EMAILS on the backend only.
